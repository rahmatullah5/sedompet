{
  "hosting": {
    "public": "build/web",
    "predeploy": "flutter build web --release --no-tree-shake-icons --dart-define-from-file=../sedompet.env.json",
    "site": "YOUR_FIREBASE_HOSTING_SITE",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
